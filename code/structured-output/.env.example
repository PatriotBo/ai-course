# 真实 OpenAI-compatible provider 配置
LLM_PROVIDER=glm
LLM_API_KEY=replace_with_your_real_api_key
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-5.2

# 腾讯混元示例
# LLM_PROVIDER=hunyuan
# LLM_API_KEY=replace_with_your_real_api_key
# LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# LLM_MODEL=hunyuan-turbos-latest

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000

# text 兼容性最好；provider 明确支持 JSON mode 时可改为 json_object。
LLM_RESPONSE_MODE=text
